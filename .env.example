# Copiez ce fichier en `.env` pour le développement local (et chargez-le avec
# `export $(cat .env | xargs)` ou un outil comme python-dotenv / direnv).
# En production (Render), ces variables sont définies dans le dashboard du
# service ou via render.yaml — ne jamais commiter de vraies valeurs ici.

# Clé secrète Flask (signature des sessions et jetons CSRF). Générez une
# valeur aléatoire en prod, par ex. : python -c "import secrets; print(secrets.token_hex(32))"
PRIOSANTE_SECRET_KEY=change_me_to_a_secure_value

# URI SQLAlchemy. Laissez vide en local pour utiliser le SQLite par défaut
# (instance/priosante.sqlite). En production, Render injecte automatiquement
# une URL PostgreSQL au format postgres://...
DATABASE_URL=

# Active le mode debug Flask (rechargement auto + traceback interactif).
# Ne JAMAIS activer en production : le débogueur Werkzeug permet l'exécution
# de code arbitraire si le serveur est accessible publiquement.
FLASK_DEBUG=1

# Port d'écoute pour `python run.py` en local. Render fournit sa propre
# valeur automatiquement en production.
PORT=5000
